<group name="custom_rules,purple_team,mitre_attck,">

  <!-- ===================================================================== -->
  <!-- PHẦN 1: TẬP LUẬT TÙY CHỈNH GIÁM SÁT WINDOWS SERVER (SYSMON TELEMETRY) -->
  <!-- ===================================================================== -->

  <!--
    Kỹ thuật: T1047 - Windows Management Instrumentation (WMI)
    Mô tả: Bắt hành vi lạm dụng wmic.exe, cmd.exe, powershell.exe thực thi lệnh qua WMI 'process call create'
    Tiến trình cha - con: wmiprvse.exe gọi các công cụ thực thi lệnh.
    Cảm biến: Sysmon Event ID 1 (61603) / Windows Security 4688 (92032)
  -->
  <rule id="100001" level="12">
    <if_sid>61603, 92032</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(wmic\.exe|Cmd\.Exe|PowerShell\.EXE|pwsh\.dll)$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)process\s+call\s+create</field>
    <description>Execution: Phát hiện lạm dụng công cụ hệ thống để gọi WMI thực thi mã (T1047)</description>
    <mitre>
      <id>T1047</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1003.001 - OS Credential Dumping: LSASS Memory
    Mô tả: Bắt hành vi mở handle can thiệp trái phép vào vùng nhớ tiến trình lsass.exe (Procdump, Mimikatz,...)
    Whitelist: svchost, csrss, wininit, services, lsass, smss, lsm, VBoxService, vmtoolsd
    Cảm biến: Sysmon Event ID 10 (ProcessAccess)
  -->
  <rule id="100002" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)[\\/](svchost|csrss|wininit|services|lsass|smss|lsm|VBoxService|vmtoolsd)\.exe$</field>
    <description>Credential Access: Phát hiện tiến trình bất thường can thiệp bộ nhớ LSASS (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1053.005 - Scheduled Task/Job: Scheduled Task
    Mô tả: Phát hiện hành vi khởi tạo Scheduled Task bằng tham số /create từ schtasks.exe
    Anti-Bypass: Đối soát trường win.eventdata.originalFileName chống đổi tên tệp thực thi
    Cảm biến: Sysmon Event ID 1 (61603) / Windows Security 4688 (92032)
  -->
  <rule id="100003" level="12">
    <if_sid>61603, 92032</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\/create</field>
    <description>Persistence: Phát hiện hành vi tạo lập Scheduled Task (Anti-Bypass T1053.005)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1082 - System Information Discovery
    Mô tả: Phát hiện trình thông dịch lệnh (powershell, cmd, wscript, cscript) tự động gọi công cụ điều tra hệ thống
    Anti-Bypass: Đối soát trường win.eventdata.originalFileName (systeminfo, whoami, ipconfig, route, net)
    Cảm biến: Sysmon Event ID 1 (61603) / Windows Security 4688 (92032)
  -->
  <rule id="100004" level="12">
    <if_sid>61603, 92032</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(systeminfo\.exe|whoami\.exe|ipconfig\.exe|route\.exe|net\.exe)$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(powershell\.exe|pwsh\.exe|cmd\.exe|wscript\.exe|cscript\.exe)$</field>
    <description>Discovery: Phát hiện trình thông dịch lệnh thực thi công cụ dò thám hệ thống (Anti-Bypass T1082)</description>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1486 - Data Encrypted for Impact (Ransomware trên Windows)
    Mô tả: Quét nội dung script block phát hiện sự xuất hiện đồng thời của hàm ghi file (WriteAllBytes, Out-File)
           và các từ khóa tống tiền/kênh Darkweb (.onion, torproject, decrypt, recover, encrypted) - Giả lập Akira Ransomware
    Cảm biến: Windows PowerShell Event Logs
  -->
  <rule id="100005" level="14">
    <if_group>windows</if_group>
    <regex type="pcre2">(?i)WriteAllBytes|Out-File</regex>
    <regex type="pcre2">(?i)\.onion|torproject|decrypt|recover|encrypted</regex>
    <description>Impact: Phát hiện hành vi sinh file mã hóa kết hợp với thông điệp tống tiền/Darkweb (T1486)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1070.001 - Indicator Removal on Host: Clear Windows Event Logs
    Mô tả: Phát hiện hành vi xóa nhật ký kiểm toán hệ thống (wevtutil cl System/Security)
    Cảm biến: Windows Security Log Event ID 1102 / Sysmon / Command Line
  -->
  <rule id="100007" level="13">
    <if_sid>18104, 18105, 92032, 61603</if_sid>
    <field name="win.system.eventID">^1102$</field>
    <description>Defense Evasion: Nhật ký kiểm toán bảo mật Windows bị xóa bỏ (T1070.001 - Event ID 1102)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- PHẦN 2: TẬP LUẬT TÙY CHỈNH GIÁM SÁT LINUX (AUDITD & FIM TELEMETRY)   -->
  <!-- ===================================================================== -->

  <!--
    Kỹ thuật: T1059.004 - Command and Scripting Interpreter: Unix Shell
    Mô tả: Bắt chuỗi hành vi bất biến của Reverse Shell & Fileless Malware: giải mã payload (base64, openssl),
           thực thi mã nội tuyến (python -c, perl -e), tạo interactive shell (sh/bash -i) hoặc Netcat kết nối ngược (nc -e)
    Cảm biến: Linux Auditd execve Syscall (nhóm sự kiện audit)
  -->
  <rule id="100010" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">["/](?:ba|da|z)?sh".*"-i"|(?:base64|openssl)".*"(?:--?d|--decode|base64)"|(?:python|perl|ruby)\S*".*"-[ce]"|nc\S*".*"-e"</regex>
    <description>Execution: Phát hiện chuỗi hành vi bất biến của Reverse Shell/Fileless Malware - giải mã payload, thực thi mã nội tuyến, hoặc khởi tạo Interactive Shell trái phép (T1059.004)</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1548.003 - Abuse Elevation Control Mechanism: Sudo Caching
    Mô tả: Phát hiện hành vi can thiệp trái phép, ghi cấu hình NOPASSWD vào thư mục /etc/sudoers.d/
    Cảm biến: Linux Auditd (audit.key: audit_sudoers hoặc sudoers_monitor)
  -->
  <rule id="100012" level="12">
    <if_group>audit</if_group>
    <field name="audit.key">^(audit_sudoers|sudoers_monitor)$</field>
    <description>Privilege Escalation: Phát hiện tiến trình trái phép can thiệp vào cấu hình SUDO (T1548.003)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1486 - Data Encrypted for Impact (Ransomware trên Linux)
    Mô tả: Phát hiện hành vi mã hóa hàng loạt bằng OpenSSL (enc -aes-256-cbc) hoặc hủy dữ liệu vĩnh viễn bằng lệnh shred -u
    Cảm biến: Linux Auditd execve Syscall
  -->
  <rule id="100013" level="14">
    <if_group>audit</if_group>
    <regex type="pcre2">"openssl".*"enc".*"-aes-256-cbc"|"shred".*"-u"</regex>
    <description>Impact: Phát hiện hành vi xóa file an toàn bằng shred hoặc nén mã hóa dữ liệu (T1486)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!--
    Kỹ thuật: T1003.008 - OS Credential Dumping: /etc/shadow
    Mô tả: Phát hiện mọi hành vi truy cập đọc hoặc sao chép tập tin mật khẩu nhạy cảm /etc/shadow
    Cảm biến: Linux Auditd (audit.key: shadow_monitor)
  -->
  <rule id="100014" level="12">
    <if_group>audit</if_group>
    <field name="audit.key">shadow_monitor</field>
    <description>Credential Access: Tiến trình truy cập đọc tệp tin mật khẩu nhạy cảm /etc/shadow (T1003.008)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

</group>
